# Frontend environment variables
# Copy this file to .env and fill in your values

# The full URL of your backend API (no trailing slash)
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api

# Production (replace with your Render backend URL):
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# WARNING: NEVER put MongoDB credentials, JWT secrets, passwords, or backend secrets here!
# VITE_ variables are automatically bundled into the public frontend code.
