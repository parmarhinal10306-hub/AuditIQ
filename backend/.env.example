# Backend environment variables
# Copy this file to .env and fill in your values

# Port the Express server listens on (Render sets this automatically)
PORT=5000

# MongoDB connection string
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/auditiq
# MongoDB Atlas (replace with your Atlas connection string):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JSON Web Token secret — use a long, random string in production
JWT_SECRET=replace_with_a_long_random_secret_string

# Node environment — set to "production" on Render
NODE_ENV=production

# Allowed frontend origin for CORS (no trailing slash)
# Local development:
# FRONTEND_URL=http://localhost:5173
# Production (replace with your Vercel URL):
FRONTEND_URL=https://your-frontend.vercel.app
